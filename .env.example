# Copy this file to .env and fill in your keys. NEVER commit .env to git.

# --- Alpaca (get keys at https://app.alpaca.markets — use the PAPER dashboard first) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Anthropic (optional — powers the LLM judgment layer + X post copy) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- X / Twitter API (get at https://developer.x.com — Free tier allows posting) ---
# Create a Project + App, set app permissions to "Read and write",
# then generate these under "Keys and tokens":
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Alerting (needed once the bot runs anywhere other than your laptop) ---
# Without these, alerts fall back to a macOS notification — which does not
# exist on a server, so every alert would go to a log file nobody reads.
#
# ALERT_WEBHOOK_URL: a POST whenever the agent needs attention (missed cycle,
# preflight failure, SLO breach).
#
# This line used to claim "any Slack/Discord/n8n-style incoming webhook works",
# which was false for two of the three — and false in the worst way, because a
# rejected webhook only logs a warning and falls back to the desktop banner.
# You would paste a URL, see no error, and believe you were covered.
#
# Per-receiver formatting IS built as of 2026-07-30 — src/alerting.py
# `_shape()` rewrites both the URL and the body per destination:
#
#   ntfy.sh/<topic>  posted to the server ROOT with the topic in the body, so
#                    it renders as a title + message, not as raw JSON
#   Discord webhook  sent as `content`   (400-rejected before this)
#   Slack webhook    sent as `text`      (400-rejected before this)
#   anything else    unchanged {title, message, source} — n8n / Zapier /
#                    Pipedream catch-hooks, or any endpoint you control
#
# Self-hosted ntfy on a custom domain is NOT detected and takes the generic
# shape: an ugly notification, not a silent failure.
#
# Set it with ./scripts/set_alert_webhook.sh — it never echoes the URL and
# refuses to exit 0 unless a real alert was delivered.
#
# To read the topic back so you can type it into the phone app (the `^` matters
# — without it this also matches the comment you are reading and prints a junk
# line first):
#   grep '^ALERT_WEBHOOK_URL=' .env | cut -d/ -f4
# Read it off the screen. Do NOT screenshot it or paste it into a chat; see
# docs/secrets_rotation.md for why that is written down.
#
# Or check delivery by hand:
#   python -c "import sys; sys.path.insert(0,'src'); \
#     from dotenv import load_dotenv; load_dotenv(); import alerting; \
#     print(alerting.send('test', 'hello'))"
# It prints which channel carried it. "webhook" is the only one that means the
# webhook worked; "desktop" and "log-only" both mean it did not.
ALERT_WEBHOOK_URL=
#
# HEARTBEAT_PING_URL: a healthchecks.io-style check URL, pinged after every
# cycle. THIS IS THE ONE THAT MATTERS MOST when the bot is unattended: every
# other check runs ON the host, so if the host dies there is nothing left to
# notice. An outside service alerting you when pings STOP is the only monitor
# that survives the machine going away. Treat the URL as a secret.
HEARTBEAT_PING_URL=

# --- Safety interlock ---
# Live trading requires BOTH mode: live in config.yaml AND this set to YES.
LIVE_TRADING_CONFIRMED=NO
