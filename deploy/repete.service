# systemd unit for the VPS path — brings the agent back after a reboot.
#
#   sudo cp deploy/repete.service /etc/systemd/system/
#   sudo sed -i "s|/opt/repete|$(pwd)|" /etc/systemd/system/repete.service
#   sudo systemctl enable --now repete
#
# docker compose already has `restart: unless-stopped`, which covers container
# crashes; this covers HOST reboots, which that flag alone does not.

[Unit]
Description=Repete trading agent (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/repete
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# A slow image pull on a cold boot must not be mistaken for a failure.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
